# ---- Vision3D AI - production / deployment environment ----
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Both the backend (via pydantic-settings) and Docker Compose read this file.
# The backend also accepts its legacy names (SECRET_KEY, MONGODB_URL, S3_*);
# the canonical names below are preferred.

# --- Environment ---
ENVIRONMENT=production
DEBUG=false

# --- Secrets -----------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET signs access tokens. JWT_REFRESH_SECRET signs refresh tokens;
# if left empty, JWT_SECRET is used for both. Keep them at least 32 bytes.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Database (MongoDB Atlas or self-hosted) ----------------------------------
DATABASE_URL=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vision3d
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# --- AI model -----------------------------------------------------------------
# mock | stable-fast-3d | hunyuan3d | custom
AI_MODEL=stable-fast-3d
AI_DEVICE=cuda
AI_MAX_IMAGE_SIZE=1024
AI_VALIDATION=strict
AI_PREVIEW_RENDER=true
AI_OBJ_EXPORT=true
AI_DEFAULT_RETRIES=1
AI_BATCH_CONCURRENCY=1

# Path to a locally mounted custom model (used by the custom adapter as {model_path}).
MODEL_PATH=/models/vision3d-custom

# --- Storage (S3-compatible object storage: AWS S3, MinIO, Spaces, ...) -------
STORAGE_BACKEND=s3
STORAGE_BUCKET=vision3d-models
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
S3_REGION=us-east-1

# --- URLs ---------------------------------------------------------------------
# Public origin of the frontend. Added to CORS_ORIGINS automatically.
FRONTEND_URL=https://vision3d.example.com
# Public origin of the backend API.
BACKEND_URL=https://api.vision3d.example.com
# Extra allowed CORS origins, comma separated (FRONTEND_URL is always allowed).
CORS_ORIGINS=

# --- Upload limits -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- Background job worker -----------------------------------------------------
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_RETRIES=3
JOB_STALE_TIMEOUT_MINUTES=30

# --- Rate limiting (slowapi, in-app) -------------------------------------------
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=30/hour
RATE_LIMIT_GENERAL=240/hour

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
