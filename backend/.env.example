# ---- Vision3D AI backend configuration ----
# Copy to `.env` and fill in real values. Never commit `.env`.

ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# --- CORS ---
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_TTL_DAYS=30

# --- Database (MongoDB Atlas or local) ---
MONGODB_URL=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vision3d
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# --- Storage: local (default) or s3 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Upload validation ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# --- AI model selection ---
# mock | stable-fast-3d | hunyuan3d | custom
AI_MODEL=mock
AI_DEVICE=auto
AI_MAX_IMAGE_SIZE=1024
STABLE_FAST_3D_REPO=stabilityai/stable-fast-3d
STABLE_FAST_3D_DEVICE=cuda
STABLE_FAST_3D_WEIGHT_DTYPE=fp16
HUNYUAN3D_DIFFUSION_REPO=tencent/Hunyuan3D-2
HUNYUAN3D_DEVICE=cuda
HUNYUAN3D_INCURSOR_DEVICE=cuda

# --- Background job worker ---
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_RETRIES=3
JOB_STALE_TIMEOUT_MINUTES=30

# --- Rate limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=30/hour

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false