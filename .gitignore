"""Domain models package for Vision3D AI."""

"""Domain enums for Vision3D AI."""
from __future__ import annotations

from enum import Enum


class JobStatus(str, Enum):
    QUEUED = "queued"
    PROCESSING = "processing"
    SUCCEEDED = "succeeded"
    FAILED = "failed"
    CANCELLED = "cancelled"


class JobStage(str, Enum):
    UPLOADED = "uploaded"
    PROCESSING = "processing"
    GENERATING = "generating"
    TEXTURE = "texture"
    POSTPROCESS = "postprocess"
    COMPLETED = "completed"
    FAILED = "failed"


class UserRole(str, Enum):
    USER = "user"
    ADMIN = "admin"


class ModelFormat(str, Enum):
    GLB = "glb"
    GLTF = "gltf"
    OBJ = "obj"

"""Model asset document schema."""
from __future__ import annotations

from datetime import UTC, datetime
from typing import Any, Dict, Optional

from pydantic import BaseModel, ConfigDict, Field

from app.core.object_id import PyObjectId, make_object_id


class ModelAssetDocument(BaseModel):
    model_config = ConfigDict(populate_by_name=True, arbitrary_types_allowed=True)

    id: PyObjectId = Field(default_factory=make_object_id, alias="_id")
    user_id: PyObjectId
    project_id: PyObjectId
    job_id: Optional[PyObjectId] = None
    glb_key: str
    gltf_key: Optional[str] = None
    preview_key: Optional[str] = None
    obj_key: Optional[str] = None
    filename: str = "model.glb"
    size_bytes: int = 0
    mime_type: str = "model/gltf-binary"
    provider: str = "local"
    stats: Dict[str, Any] = Field(default_factory=dict)
    created_at: datetime = Field(default_factory=lambda: datetime.now(UTC))
"""Model metadata document schema."""
from __future__ import annotations

from datetime import UTC, datetime
from typing import Any, Dict, List, Optional

from pydantic import BaseModel, ConfigDict, Field

from app.core.object_id import PyObjectId, make_object_id
from app.models.enums import ModelFormat


class BoundingBox(BaseModel):
    model_config = ConfigDict(populate_by_name=True)

    min: List[float] = Field(default_factory=list)
    max: List[float] = Field(default_factory=list)
    size: List[float] = Field(default_factory=list)
    center: List[float] = Field(default_factory=list)


class ModelMetadataDocument(BaseModel):
    model_config = ConfigDict(populate_by_name=True, arbitrary_types_allowed=True)

    id: PyObjectId = Field(default_factory=make_object_id, alias="_id")
    generation_id: PyObjectId
    file_format: ModelFormat = ModelFormat.GLB
    file_size: int = 0
    vertices: int = 0
    faces: int = 0
    polygons: int = 0
    materials: List[str] = Field(default_factory=list)
    textures: List[str] = Field(default_factory=list)
    bounding_box: Optional[BoundingBox] = None
    generation_time: float = 0.0
    extra: Dict[str, Any] = Field(default_factory=dict)
    created_at: datetime = Field(default_factory=lambda: datetime.now(UTC))

